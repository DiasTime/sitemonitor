    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "Cron tick runs only if last check is 45+ min old",
        "8 parallel probes, 10 s timeout, 2 re-checks",
        "Pushed mid-run; dashboard polls every 30 s"
      ]
    },
    {
      "dot": "violet",
      "title": "Triggers and alerts",
      "items": [
        "3 cron ticks/hour aim for 1 real run",
        "Run check, heartbeat, bot /check: repository_dispatch",
        "Alerts on transitions, 6 h reminders, gap alert"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Bot token, portal creds: Actions secrets only",
        "Vercel: fine-grained PAT, server-only env",
        "Webhook secret required; heartbeat token optional"
      ]
    },
    {
      "dot": "amber",
      "title": "Concurrent writes",
      "items": [
        "One monitor run at a time, never cancelled",
        "API writes retry SHA conflicts, 4 attempts",
        "Final push rebases and retries 5 times"
