# ---------------------------------------------------------------------------
# Vercel environment variables (server-side only — never exposed to the browser)
# ---------------------------------------------------------------------------

# Fine-grained personal access token with Read and Write access to
# "Contents" on THIS repository only.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# The GitHub user or organisation that owns the repository.
GITHUB_OWNER=your-github-username

# The repository name (without the owner prefix).
GITHUB_REPO=sitemonitor

# Password for the dashboard. There are no user accounts — this is the only login.
ADMIN_PASSWORD=change-me-to-something-long

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Branch the JSON data lives on. Defaults to "main".
# GITHUB_BRANCH=main

# Signing key for the session cookie. Defaults to a value derived from
# ADMIN_PASSWORD; set it to invalidate sessions without changing the password.
# SESSION_SECRET=

# How long the dashboard caches GitHub API reads, in seconds. Defaults to 20.
# DATA_CACHE_TTL_SECONDS=20

# /api/heartbeat — the outside clock. Ping it every 5-15 minutes from anything
# that can fetch a URL (GitLab schedule, uptime service, cron box) and a
# schedule GitHub failed to serve is repaired within minutes. A run is started
# only when the last check is older than HEARTBEAT_STALE_MINUTES, so frequent
# pings are free. Unset HEARTBEAT_TOKEN leaves the endpoint open; set it to
# require ?token=... or "Authorization: Bearer ...".
# HEARTBEAT_TOKEN=
# HEARTBEAT_STALE_MINUTES=75

# ---------------------------------------------------------------------------
# GitHub Actions secrets — set these under Settings -> Secrets and variables ->
# Actions, NOT here. Listed for reference only.
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_SUBSCRIBE_PASSWORD=            Require "/start <passphrase>" to subscribe
#
# Credentials for "login" monitors (portals the tool actually signs into) —
# one JSON object. A "default" entry applies to every login monitor, so when
# the same account works everywhere, this is all you need:
# PORTAL_CREDENTIALS={"default":{"username":"...","password":"..."}}
#
# A per-id entry (the monitor's id, shown on its card / in data/monitors.json)
# overrides or extends "default" for just that monitor — handy for the odd
# field that differs, e.g. a portal whose API needs an X-Site-Key header to
# pick the right tenant (see "Portal login checks" in the README):
# PORTAL_CREDENTIALS={"default":{"username":"...","password":"..."},"darynast-kz":{"siteKey":"..."}}
#
# Repository variables (Settings -> Secrets and variables -> Actions -> Variables):
# DISPLAY_TIMEZONE=Asia/Almaty    IANA zone for times in Telegram alerts (default UTC)
# LOOP_MINUTES=1                  How long one run keeps checking
# LOOP_INTERVAL_SECONDS=60        Interval between checks inside a run
# CONFIRM_RETRIES=2               Extra probes a failure must survive before it
#                                 counts as DOWN; 0 believes the first answer
# CONFIRM_DELAY_SECONDS=10        Pause between those probes
# MIN_GAP_MINUTES=45              A scheduled tick landing sooner than this after
#                                 the last check exits without checking
# STALE_AFTER_MINUTES=90          How long a gap in checking has to be before it
#                                 is reported to Telegram
